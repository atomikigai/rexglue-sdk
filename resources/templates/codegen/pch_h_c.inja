// CRRegister::compare<T> is a C++ template method (include/rex/ppc/context.h);
// the C backend calls a free-function equivalent instead (see
// emitCompareRegister/emitCompareImmediate/emitCompareToZero in
// src/codegen/builders/helpers.h). x360_cr_compare_s64/u64/f64 are provided
// by x360rt/ppc.h (included above); s32/u32 have no other guest-visible use
// in x360rt, so this backend defines them here, matching the s64/u64 shape.
static inline void x360_cr_compare_s32(PPCCRRegister* cr, s32 left, s32 right,
                                       const PPCXERRegister* xer) {
  cr->lt = (u8)(left < right);
  cr->gt = (u8)(left > right);
  cr->eq = (u8)(left == right);
  cr->so = xer->so;
}

static inline void x360_cr_compare_u32(PPCCRRegister* cr, u32 left, u32 right,
                                       const PPCXERRegister* xer) {
  cr->lt = (u8)(left < right);
  cr->gt = (u8)(left > right);
  cr->eq = (u8)(left == right);
  cr->so = xer->so;
}

// C-ABI free-function equivalents of PPCCRRegister::setFromMask's two
// overloads (include/rex/ppc/context.h:103-117; see crSetFromMask,
// src/codegen/builders/helpers.h, for the C++ member-call vs C free-function
// selection this backend emits).
static inline void x360_cr_set_from_mask_ps(PPCCRRegister* cr, simde__m128 mask, int imm) {
  int m = simde_mm_movemask_ps(mask);
  cr->lt = (u8)(m == imm);
  cr->gt = 0;
  cr->eq = (u8)(m == 0);
  cr->so = 0;
}

static inline void x360_cr_set_from_mask_epi8(PPCCRRegister* cr, simde__m128i mask, int imm) {
  int m = simde_mm_movemask_epi8(mask);
  cr->lt = (u8)(m == imm);
  cr->gt = 0;
  cr->eq = (u8)(m == 0);
  cr->so = 0;
}

