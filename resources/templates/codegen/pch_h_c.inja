//=============================================================================
// Setjmp/Longjmp
//
// The C++ backend keys a std::unordered_map<u32, jmp_buf> by guest buffer
// address; C11 has no thread-local hash map in the standard library, so this
// uses a fixed-size (64 entries) thread-local table instead. 64 concurrent
// live setjmp targets per thread comfortably covers guest code, which rarely
// nests more than a handful of longjmp scopes.
//=============================================================================

typedef struct {
  u32 addr;
  int used;
  jmp_buf buf;
} RexJmpEntry;

#define REX_JMP_TABLE_SIZE 64

static thread_local RexJmpEntry rex_jmp_table_[REX_JMP_TABLE_SIZE];

static inline jmp_buf* rex_get_jmp_buf_(u32 addr) {
  for (int i = 0; i < REX_JMP_TABLE_SIZE; i++) {
    if (rex_jmp_table_[i].used && rex_jmp_table_[i].addr == addr)
      return &rex_jmp_table_[i].buf;
  }
  for (int i = 0; i < REX_JMP_TABLE_SIZE; i++) {
    if (!rex_jmp_table_[i].used) {
      rex_jmp_table_[i].used = 1;
      rex_jmp_table_[i].addr = addr;
      return &rex_jmp_table_[i].buf;
    }
  }
  x360_fatal_unimplemented(addr, "ppc_setjmp: table full");
  return &rex_jmp_table_[0].buf;
}

#define ppc_setjmp(guest_buf_addr) (setjmp(*rex_get_jmp_buf_((u32)(guest_buf_addr))))

static inline void ppc_longjmp(u32 guest_buf_addr, int val) {
  for (int i = 0; i < REX_JMP_TABLE_SIZE; i++) {
    if (rex_jmp_table_[i].used && rex_jmp_table_[i].addr == guest_buf_addr) {
      longjmp(rex_jmp_table_[i].buf, val);
    }
  }
  abort();
}

