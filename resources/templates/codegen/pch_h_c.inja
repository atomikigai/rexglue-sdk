// equivalent bit-cast syntax usable in a constant expression, but the exact
// bit pattern (not just an approximately-equal decimal literal) matters
// here, so this reproduces it via Clang's __builtin_bit_cast instead.
#define X360_BITS_TO_F32(bits) __builtin_bit_cast(float, (u32)(bits))
static const float kPack2101010_Min10 = X360_BITS_TO_F32(0x403FFE01u);
static const float kPack2101010_Max10 = X360_BITS_TO_F32(0x404001FFu);
